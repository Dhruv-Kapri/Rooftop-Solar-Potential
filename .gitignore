# Data — LiDAR point clouds, DSMs, imagery are huge; never commit
data/
outputs/
*.tif
*.laz
*.las
*.copc.laz

# Run logs (batch-run stdout, e.g. city_run*.log) — transient artifacts, not source. The
# real compute-cost run-log is written into docs/benchmarks from a cold run, not committed here.
*.log

# Secrets
.env

# Jupyter — committed notebooks keep their rendered outputs; ignore only the scratch state
.ipynb_checkpoints/
# osmnx Overpass API response cache, written when a notebook runs (path depends on cwd)
cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Rendered diagram artifacts (source .mmd is committed; PNGs are embedded in notebooks)
notebooks/diagrams/*.png
