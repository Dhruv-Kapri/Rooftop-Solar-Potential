# Data — LiDAR point clouds, DSMs, imagery are huge; never commit
data/
outputs/
*.tif
*.laz
*.las
*.copc.laz

# Secrets
.env

# Jupyter — committed notebooks keep their rendered outputs; ignore only the scratch state
.ipynb_checkpoints/
# osmnx Overpass API response cache, written when a notebook runs
notebooks/cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Rendered diagram artifacts (source .mmd is committed; PNGs are embedded in notebooks)
notebooks/diagrams/*.png
