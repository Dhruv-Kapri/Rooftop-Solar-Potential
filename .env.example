# Copy to .env and fill in. .env is gitignored — never commit real keys.

# NREL -> NLR (National Laboratory of the Rockies) developer API.
# Free key: https://developer.nlr.gov/signup  (used for NSRDB + PVWatts v8).
# Old developer.nrel.gov keys still work, but use the developer.nlr.gov domain.
NLR_API_KEY=

# NLR APIs want an email alongside the key.
NLR_API_EMAIL=
